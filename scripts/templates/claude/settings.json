{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Phobos para Claude Code — permission allowlist por defecto. Cubre las operaciones que los agentes (phobos, researcher, planner, programmer, tester, archivist) hacen constantemente, para que no veas un prompt 'Do you want to proceed?' en cada Bash. Mantenemos un denylist explícito para secretos (.env, *.pem, etc) que gana sobre cualquier allow. Si tu proyecto tiene paths sensibles distintos, agregalos al `deny` y reinstalá las settings.",
  "permissions": {
    "allow": [
      "Bash(node vault/memory/.engine/search.mjs *)",
      "Bash(node vault/memory/.engine/index-vault.mjs *)",
      "Bash(node vault/memory/.engine/list-memory.mjs *)",
      "Bash(node vault/memory/.engine/costs.mjs *)",
      "Bash(node .codegraph/cg.cjs *)",
      "Bash(mkdir -p vault/*)",
      "Bash(mkdir -p vault/memory/*)",
      "Bash(date *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(rg *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Read(./vault/**)",
      "Edit(./vault/**)",
      "Write(./vault/**)",
      "Read(./.codegraph/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/credentials.json)",
      "Read(./**/master.key)",
      "Read(./config/credentials/**)",
      "Read(./config/master.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/secrets/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)",
      "Write(./secrets/**)",
      "Write(./**/secrets/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)"
    ]
  }
}
