{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "Phobos para Claude Code — permission allowlist por defecto. Cubre las operaciones que los agentes (phobos, researcher, planner, programmer, tester, reviewer, archivist) hacen constantemente, para que no veas un prompt 'Do you want to proceed?' en cada Bash. Mantenemos un denylist explícito para secretos (.env, *.pem, etc) que gana sobre cualquier allow. Si tu proyecto tiene paths sensibles distintos, agregalos al `deny` y reinstalá las settings.",
  "enabledMcpjsonServers": ["context7"],
  "permissions": {
    "allow": [
      "Bash(node vault/memory/.engine/launcher.mjs *)",
      "Bash(node .codegraph/launcher.mjs *)",
      "Bash(mkdir -p vault/*)",
      "Bash(mkdir -p vault/memory/*)",
      "Bash(date *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(rg *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Read(./vault/**)",
      "Edit(./vault/**)",
      "Write(./vault/**)",
      "Read(./.codegraph/**)",
      "mcp__context7"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/credentials.json)",
      "Read(./**/master.key)",
      "Read(./config/credentials/**)",
      "Read(./config/master.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/secrets/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)",
      "Write(./secrets/**)",
      "Write(./**/secrets/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)"
    ]
  },
  "$comment_hooks": "Capa de enforcement portada de agent-cargo (Claude Code only). guard.cjs aplica la política global de comandos (policies.json). audit.cjs deja un rastro JSONL y, en SubagentStop, detecta reports cortados (sentinel FIN-PHOBOS-REPORT). El confinamiento per-agente de Edit/Write vive en el frontmatter `hooks:` de cada agente (paths-allow.cjs), no acá.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit.cjs\" --event SessionStart" } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.cjs\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|Bash", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit.cjs\" --event PostToolUse" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit.cjs\" --event SubagentStop" } ] }
    ]
  }
}
