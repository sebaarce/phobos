# Phobos Memory engine — isolated install config.
# Garantiza buena conducta del package manager dentro de vault/memory/.engine/
# sin importar qué hace el proyecto host (pnpm workspace, monorepo, etc.).

# Si el proyecto host es un pnpm workspace, NO hoistear el install al root.
# Memory vive aislado.
ignore-workspace=true

# Forzar node_modules plano (npm-style) — algunos consumidores ESM tienen
# problemas con la estructura symlinked de pnpm.
node-linker=hoisted

# Defensivo extra para pnpm legacy.
shamefully-hoist=true

# Los paquetes que usamos (transformers + qdrant + onnxruntime) suelen tener
# peer-deps que se conflictúan en npm v7+. Como es un install aislado, no
# afecta al árbol del proyecto principal.
legacy-peer-deps=true
